<Window x:Class="Dynamo.Wpf.Views.FileTrust.FileTrustPreviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Dynamo.Wpf.Properties;assembly=DynamoCoreWpf"
        xmlns:ui="clr-namespace:Dynamo.UI"
        xmlns:fa="clr-namespace:FontAwesome5;assembly=FontAwesome5.Net"
        Title="{x:Static p:Resources.FileTrustWarningPopupTitle}"
        Width="760"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        ShowInTaskbar="False"
        Style="{DynamicResource DynamoWindowStyle}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Window.Background>
        <SolidColorBrush Opacity="0" />
    </Window.Background>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:SharedResourceDictionary Source="{x:Static ui:SharedDictionaryManager.DynamoConvertersDictionaryUri}" />
                <ui:SharedResourceDictionary Source="{x:Static ui:SharedDictionaryManager.DynamoColorsAndBrushesDictionaryUri}" />
                <ui:SharedResourceDictionary Source="{x:Static ui:SharedDictionaryManager.DynamoModernDictionaryUri}" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Command="Close" Key="Esc" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="OnCloseExecuted" />
    </Window.CommandBindings>

    <Grid Background="Transparent" Margin="10">
        <Border Background="White"
                CornerRadius="4"
                BorderThickness="0">
            <Border.Effect>
                <DropShadowEffect Color="#000" ShadowDepth="0" Opacity="0.25" BlurRadius="10.0" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Title bar  -->
                <DockPanel Grid.Row="0"
                           Margin="20,16,16,16"
                           Background="Transparent"
                           MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <fa:ImageAwesome Width="18"
                                     Height="18"
                                     Margin="0,0,10,0"
                                     DockPanel.Dock="Left"
                                     VerticalAlignment="Center"
                                     Foreground="#FAA21B"
                                     Icon="Solid_ExclamationTriangle" />
                    <Button x:Name="CloseButton"
                            DockPanel.Dock="Right"
                            Click="DeclineButton_Click"
                            Style="{StaticResource CloseButtonStyle}" />
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource ArtifaktElementRegular}"
                               FontSize="18"
                               Foreground="#3C3C3C"
                               Text="{x:Static p:Resources.FileTrustWarningPopupTitle}" />
                </DockPanel>
                <Rectangle Grid.Row="0"
                           Height="1"
                           VerticalAlignment="Bottom"
                           Fill="#B7B7B7" />

                <!--  Message and file path  -->
                <StackPanel Grid.Row="1" Margin="20,16,20,10">
                    <TextBlock FontFamily="{StaticResource ArtifaktElementRegular}"
                               FontSize="14"
                               Foreground="#3C3C3C"
                               TextWrapping="Wrap"
                               Text="{x:Static p:Resources.FileTrustWarningPopupText}" />
                    <TextBlock x:Name="FilePathTextBlock"
                               Margin="0,6,0,0"
                               FontFamily="{StaticResource ArtifaktElementRegular}"
                               FontSize="12"
                               Foreground="#808080"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--  Read-only preview  -->
                <StackPanel Grid.Row="2" Margin="20,0,20,10">
                    <Border x:Name="PreviewBorder"
                            Height="400"
                            Background="#FFEDEDED"
                            BorderBrush="#FFD0D0D0"
                            BorderThickness="1"
                            CornerRadius="2"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage"
                                   Margin="12"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="PreviewStatusTextBlock"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource ArtifaktElementRegular}"
                                       FontSize="13"
                                       Foreground="#808080"
                                       Text="{x:Static p:Resources.FileTrustPreviewLoading}" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="0,6,0,0"
                               FontFamily="{StaticResource ArtifaktElementRegular}"
                               FontSize="12"
                               Foreground="#808080"
                               TextWrapping="Wrap"
                               Text="{x:Static p:Resources.FileTrustPreviewCaption}" />
                </StackPanel>

                <!--  Trust location checkbox  -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            Margin="20,6,20,16">
                    <CheckBox x:Name="TrustLocationCheckBox"
                              Content="{x:Static p:Resources.FileTrustWarningCheckBoxText}"
                              Style="{StaticResource CheckBoxFileTrustStyle}"
                              FontFamily="{StaticResource ArtifaktElementRegular}"
                              FontSize="13" />
                    <Label VerticalAlignment="Center"
                           Height="26"
                           Width="40">
                        <Label.ToolTip>
                            <ToolTip Content="{x:Static p:Resources.FileTrustWarningPopupTooltip2}"
                                     Style="{StaticResource GenericToolTipLight}" />
                        </Label.ToolTip>
                        <Label.Content>
                            <fa:ImageAwesome Width="15"
                                             Height="15"
                                             VerticalAlignment="Bottom"
                                             HorizontalAlignment="Left"
                                             Icon="Solid_QuestionCircle"
                                             Foreground="#808080" />
                        </Label.Content>
                    </Label>
                </StackPanel>

                <!--  Buttons  -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="20,0,20,20">
                    <Button x:Name="DeclineButton"
                            MinWidth="110"
                            Margin="0,0,10,0"
                            Click="DeclineButton_Click"
                            Content="{x:Static p:Resources.FileTrustPreviewDecline}"
                            Style="{StaticResource OutlinedButtonStyleInverted}" />
                    <Button x:Name="AcceptButton"
                            MinWidth="80"
                            Click="AcceptButton_Click"
                            Content="{x:Static p:Resources.FileTrustWarningPopupYes}"
                            Style="{StaticResource SolidButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
