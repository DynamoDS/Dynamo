<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>OpenGeometry</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyTitle>OpenGeometry ProtoGeometry</AssemblyTitle>
    <Product>OpenGeometry for Dynamo</Product>
    <Company>OpenGeometry</Company>
    <Description>Fork-owned Autodesk.DesignScript.Geometry implementation backed by SMLib.</Description>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="OpenGeometry.Kernel" Value="SMLib" />
    <AssemblyMetadata Include="OpenGeometry.Origin" Value="open-geometry-dynamo" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../NodeServices/DynamoServices.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.*.txt" />
  </ItemGroup>
</Project>
