<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsTestProject>true</IsTestProject>
    <OpenGeometryNativeDirectory Condition="'$(OpenGeometryNativeDirectory)' == ''">$(MSBuildThisFileDirectory)../../bin/open-geometry/native/Release</OpenGeometryNativeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    <ProjectReference Include="../../src/OpenGeometry/ProtoGeometry/ProtoGeometry.csproj" />
    <ProjectReference Include="../../src/Engine/ProtoScript/ProtoScript.csproj" />
    <Compile Include="../../src/DynamoCore/Visualization/DefaultRenderPackageFactory.cs" Link="DefaultRenderPackageFactory.cs" />
    <Compile Include="../../src/DynamoCore/Visualization/IRenderPackageFactory.cs" Link="IRenderPackageFactory.cs" />
    <None Include="$(OpenGeometryNativeDirectory)/OpenGeometryBridge.dll" Link="OpenGeometryBridge.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(OpenGeometryNativeDirectory)/SM_API.dll" Link="SM_API.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(OpenGeometryNativeDirectory)/SMLib.dll" Link="SMLib.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
